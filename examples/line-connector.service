[Unit]
Description=LINE connector (Choco)
After=network-online.target
Wants=network-online.target

[Service]
User=chococlaw
Environment=LINE_CONNECTOR_HOME=/home/chococlaw/line-connector
EnvironmentFile=/home/chococlaw/line-connector/.env
ExecStart=/home/chococlaw/line-connector/venv/bin/python -m line_platform.standalone --config /home/chococlaw/line-connector/config.yaml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
